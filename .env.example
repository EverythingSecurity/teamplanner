# --- Azure AI Foundry (agent deployment + triage) ---
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_MODEL_DEPLOYMENT=gpt-5-mini
FOUNDRY_AGENT_NAME=cis-planning-triage

# --- Workflow ---
CIS_CONFIDENCE_THRESHOLD=0.7
CIS_MAX_BODY_CHARS=20000
CIS_DB_PATH=./cis_planning.db
CIS_ARCHITECT_MATRIX_PATH=./config/architects.json

# --- Microsoft Graph (mailbox + Planner) ---
GRAPH_MAILBOX=cis-planning@contoso.com
GRAPH_MAIL_FOLDER=inbox
PLANNER_PLAN_ID=<plan-id>
